<Window x:Class="FritzboxPhonebookConv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FritzboxPhonebookConv.ViewModels"
        xmlns:conv="clr-namespace:FritzboxPhonebookConv.Converters"
        mc:Ignorable="d"
        Title="FritzBox Phonebook Converter"
        Height="730" Width="660"
        MinHeight="600" MinWidth="520"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Shared element styles -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ===== Status bar ===== -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <ProgressBar Width="130" Height="14"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main scrollable content (disabled while busy) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
            <StackPanel Margin="12,10">

                <!-- ===== Step 1 : Connection ===== -->
                <GroupBox Header="Step 1 – Fritz.Box Connection">
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Host / Port -->
                        <Label Content="Host:" Grid.Row="0" Grid.Column="0"/>
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="0" Grid.Column="1" Margin="0,2"/>
                        <Label Content="Port:" Grid.Row="0" Grid.Column="2"/>
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="0" Grid.Column="3" Margin="0,2"/>

                        <!-- Row 1: Username -->
                        <Label Content="Username:" Grid.Row="1" Grid.Column="0"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2"/>

                        <!-- Row 2: Password + Connect -->
                        <Label Content="Password:" Grid.Row="2" Grid.Column="0"/>
                        <PasswordBox x:Name="PasswordBox"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2"/>
                        <Button Content="Connect"
                                Command="{Binding ConnectCommand}"
                                Grid.Row="2" Grid.Column="3" Margin="6,2,0,2"/>
                    </Grid>
                </GroupBox>

                <!-- ===== Step 2 : Phonebook ===== -->
                <GroupBox Header="Step 2 – Select &amp; Download Phonebook">
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <Label Content="Book:"/>
                        <ComboBox ItemsSource="{Binding Phonebooks}"
                                  SelectedItem="{Binding SelectedPhonebook}"
                                  Grid.Column="1" Margin="0,2"/>
                        <Button Content="Download XML"
                                Command="{Binding DownloadPhonebookCommand}"
                                Grid.Column="2" Margin="8,2,0,2"/>
                        <!-- Downloaded indicator -->
                        <TextBlock Grid.Column="3"
                                   Text="✔ Ready"
                                   Foreground="#2E7D32"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Visibility="{Binding HasDownloadedXml, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </GroupBox>

                <!-- ===== Step 3 : XSLT Profiles ===== -->
                <GroupBox Header="Step 3 – Manage XSLT Profiles">
                    <StackPanel Margin="2,4">

                        <!-- Profile list -->
                        <ListView ItemsSource="{Binding XsltProfiles}"
                                  SelectedItem="{Binding SelectedXsltProfile}"
                                  Height="120"
                                  Margin="0,0,0,10"
                                  SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="160"
                                                    DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="XSLT File Path" Width="370"
                                                    DisplayMemberBinding="{Binding FilePath}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Add-profile form -->
                        <Border BorderBrush="#BBBBBB" BorderThickness="1"
                                CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                           Text="Add New Profile"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <Label Content="Name:" Grid.Row="1" Grid.Column="0"/>
                                <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2"/>

                                <Label Content="XSLT File:" Grid.Row="2" Grid.Column="0"/>
                                <TextBox Text="{Binding NewProfilePath}"
                                         Grid.Row="2" Grid.Column="1"
                                         Margin="0,2" IsReadOnly="True"/>
                                <Button Content="Browse…"
                                        Command="{Binding BrowseXsltFileCommand}"
                                        Grid.Row="2" Grid.Column="2" Margin="6,2,0,2"/>
                            </Grid>
                        </Border>

                        <!-- Add / Remove buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Add Profile"
                                    Command="{Binding AddXsltProfileCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Remove Selected"
                                    Command="{Binding RemoveXsltProfileCommand}"/>
                        </StackPanel>

                    </StackPanel>
                </GroupBox>

                <!-- ===== Step 4 : Transform & Export ===== -->
                <GroupBox Header="Step 4 – Transform &amp; Export">
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>

                        <!-- XSLT picker (mirrors profile list selection) -->
                        <Label Content="XSLT:" Grid.Row="0"/>
                        <ComboBox ItemsSource="{Binding XsltProfiles}"
                                  SelectedItem="{Binding SelectedXsltProfile}"
                                  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2"/>

                        <!-- Output file -->
                        <Label Content="Output:" Grid.Row="1"/>
                        <TextBox Text="{Binding OutputFilePath}"
                                 Grid.Row="1" Grid.Column="1"
                                 Margin="0,2" IsReadOnly="True"/>
                        <Button Content="Browse…"
                                Command="{Binding BrowseOutputCommand}"
                                Grid.Row="1" Grid.Column="2" Margin="6,2,0,2"/>

                        <!-- Transform & Save -->
                        <Button Content="▶  Transform &amp; Save"
                                Command="{Binding TransformAndSaveCommand}"
                                Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,6,0,0"
                                Padding="20,6"
                                FontSize="13"
                                FontWeight="SemiBold"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
